# Copy to .env (git-ignored) and fill in. NEVER commit real values.

# --- Make.com API ---
# Token with scenarios read/write scopes. Make → Profile → API/Tokens.
MAKE_API_TOKEN=
# Optional overrides (defaults shown):
# SCENARIO_ID=9254191
# MAKE_API_BASE=https://eu2.make.com/api/v2

# --- Zoho CRM (self-client OAuth, EU data center) ---
# From Zoho API Console → Self Client. Scope: ZohoCRM.modules.ALL (read is enough to verify).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Optional overrides (defaults = EU DC):
# ZOHO_ACCOUNTS_BASE=https://accounts.zoho.eu
# ZOHO_API_BASE=https://www.zohoapis.eu
